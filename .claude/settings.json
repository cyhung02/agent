{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/init.sh"
          },
          {
            "type": "command",
            "command": "nohup python3 scripts/proxy-relay.py > /tmp/proxy-relay.log 2>&1 & disown"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "nohup python3 scripts/proxy-relay.py > /tmp/proxy-relay.log 2>&1 & disown"
          }
        ]
      }
    ]
  }
}
